{
  "name": "acoustic-mesh",
  "version": "1.0.0",
  "private": false,
  "description": "Production-grade WebRTC multi-device acoustic mesh with WebSocket signaling, sensor pipelines, and phi-harmonic modal analysis",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.0.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "keywords": ["webrtc", "websocket", "acoustic", "mesh-network", "signaling", "phi-harmonic"],
  "author": "Ndr \"Ender\" Hensel <https://github.com/Flickerflash>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flickerflash/Acoustic-mesh.git"
  }
}
