{
  "name": "acoustic-mesh",
  "version": "1.0.0",
  "private": false,
  "description": "Experimental WebRTC multi-device acoustic mesh with WebSocket signaling, sensor pipelines, and acoustic/spatial analysis infrastructure",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"node services/signaling/index.js\" \"npm run dev --workspace apps/web\"",
    "build": "tsc --noEmit",
    "start": "node services/signaling/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^5.3.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "webrtc",
    "websocket",
    "acoustic",
    "mesh-network",
    "signaling",
    "signal-processing",
    "spatial-audio"
  ],
  "author": "Ndr \"Ender\" Hensel <https://github.com/Flickerflash>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flickerflash/Acoustic-mesh.git"
  }
}
